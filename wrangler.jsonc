{
  // Messer Lineup — one Worker: static assets first, the script only for /api/v1/* and
  // /calendar/*.ics (ADR-001 §1). NEVER add "run_worker_first": a request that always reaches
  // the script is metered (free plan answers 429 at the daily limit) instead of falling back to
  // the assets, and that is what keeps a page view free.
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "messer-lineup",
  "compatibility_date": "2026-11-01",
  // Filled at P4 (the SPA build) — assets are served without invoking the script.
  "assets": {
    "directory": "./web/dist",
    "not_found_handling": "single-page-application"
  },
  // Filled at P3 (Hono: the six /api/v1 routes and the ICS endpoint).
  "main": "src/worker.ts",
  "routes": [{ "pattern": "lineup.messer.wtf", "custom_domain": true }],
  "observability": { "enabled": true }
}
